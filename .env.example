# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Google GenAI (Gemini) API key
GEMINI_API_KEY=

# Optional macro overrides, as decimal fractions (0.065 = 6.5%). Leave unset to use fallbacks.
# OPTIFIN_GSEC_10Y_YIELD=0.07
# OPTIFIN_REPO_RATE=0.065
# OPTIFIN_CPI_INFLATION=0.055
# OPTIFIN_REAL_ESTATE_INFLATION=0.07

# Gemini model selection. Fallbacks are tried in order when the model is overloaded (503/429).
# OPTIFIN_GEMINI_MODEL=gemini-2.5-flash
# OPTIFIN_GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest
